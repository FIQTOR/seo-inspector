{
  "manifest_version": 3,
  "name": "SEO Inspector — Technical SEO Audit & Analyzer",
  "version": "1.0.0",
  "description": "Production-ready technical SEO auditing tool. Inspect meta tags, headings, images, links, Open Graph, schema and technical SEO health in real-time.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}

